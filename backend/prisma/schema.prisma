generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── 1. Users ─────────────────────────────────────────────────────────────────
model User {
  id             String         @id @default(uuid())
  email          String         @unique
  name           String
  password       String
  role           String         @default("MEMBER")
  avatar         String?
  refreshToken   String?
  organizationId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workspaces    Workspace[]
  conversations Conversation[]

  @@map("users")
}

// ─── 2. Workspaces ────────────────────────────────────────────────────────────
model Workspace {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  description   String?
  ownerId       String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([ownerId])
  @@map("workspaces")
}

// ─── 3. Conversations ─────────────────────────────────────────────────────────
model Conversation {
  id                  String               @id @default(uuid())
  title               String?
  status              String               @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  userId              String
  workspaceId         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace           Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  messages            Message[]
  state               ConversationState?
  agentSpecifications AgentSpecification[]

  @@index([userId])
  @@index([workspaceId])
  @@map("conversations")
}

// ─── 4. Messages ──────────────────────────────────────────────────────────────
model Message {
  id             String       @id @default(uuid())
  conversationId String
  sender         String       // USER, ASSISTANT, SYSTEM
  content        String       @db.Text
  metadata       Json?        @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

// ─── 5. Conversation State ────────────────────────────────────────────────────
model ConversationState {
  id                    String       @id @default(uuid())
  conversationId        String       @unique
  currentStage          String       @default("INTENT_DETECTION") // INTENT_DETECTION, REQUIREMENT_GATHERING, CLARIFICATION, PLANNING, SPECIFICATION_GENERATED
  latestIntent          Json?        @default("{}")
  extractedRequirements Json?        @default("{}")
  askedQuestions        Json?        @default("[]")
  isComplete            Boolean      @default(false)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  conversation          Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_state")
}

// ─── 6. Agent Specifications ──────────────────────────────────────────────────
model AgentSpecification {
  id             String       @id @default(uuid())
  conversationId String
  name           String
  description    String?
  version        String       @default("1.0.0")
  spec           Json
  status         String       @default("DRAFT") // DRAFT, VALIDATED, READY
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("agent_specifications")
}
